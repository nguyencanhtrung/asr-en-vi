# Host port is always published on 127.0.0.1.
ASR_PORT=8765
ASR_COOKIE_SECURE=false
# Maximum source upload size (4 GiB) and audio duration (4 hours).
ASR_MAX_UPLOAD_BYTES=4294967296
ASR_MAX_RECORDING_SECONDS=14400
# Prepare a CTranslate2 faster-whisper model on the host before starting Compose.
ASR_MODEL_HOST_PATH=./models
ASR_MODEL_PATH=/models/whisper-large-v3
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
# Optional. The default follows ASR_PORT.
# ASR_PUBLIC_URL=http://127.0.0.1:8765
