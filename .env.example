# Host port is always published on 127.0.0.1.
ASR_PORT=8765
# Source mode builds this tag. Pull mode requires a version tag or sha256 digest.
ASR_IMAGE=asr-en-vi:local
ASR_COOKIE_SECURE=false
# Maximum source upload size (4 GiB) and audio duration (4 hours).
ASR_MAX_UPLOAD_BYTES=4294967296
ASR_UPLOAD_CHUNK_BYTES=67108864
ASR_MAX_RECORDING_SECONDS=14400
# Prepare a CTranslate2 faster-whisper model on the host before starting Compose.
ASR_MODEL_HOST_PATH=./models
# Auto selects GPU + large-v3 + float16, or CPU + small + int8 when no GPU exists.
ASR_DEVICE=auto
ASR_GPU_MODEL_PATH=/models/whisper-large-v3
ASR_CPU_MODEL_PATH=/models/whisper-small
ASR_DIARIZATION_MODEL_PATH=/models/speaker-diarization-community-1
ASR_GPU_COMPUTE_TYPE=float16
ASR_CPU_COMPUTE_TYPE=int8
# Optional. The default follows ASR_PORT.
# ASR_PUBLIC_URL=http://127.0.0.1:8765
# Optional callback override for a separately routed HTTP loopback callback.
# Must use http://127.0.0.1:<port>/auth/chatgpt/callback.
# ASR_CHATGPT_CALLBACK_URL=http://127.0.0.1:8765/auth/chatgpt/callback
